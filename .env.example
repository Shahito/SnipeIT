DATABASE_URL="mysql://user:password@localhost:3306/snipeit"
JWT_SECRET="change_me_with_a_long_random_string"
NODE_ENV="development"
PORT=4000

APP_URL="http://localhost:4000"

# Optional: cache directory for candles. Defaults to ./cache/candles
CANDLE_CACHE_DIR=""
# Optional - candle chart cache (see src/utils/candleCache.js)
# Days of inactivity before a pair/timeframe's cached candles are purged (default 30)
CANDLE_CACHE_MAX_AGE_DAYS=30

# SMTP (leave SMTP_HOST empty in dev to just log emails to the console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="SnipeIT <no-reply@snipeit.local>"

# Resend webhook signing secret (starts with whsec_), from Resend
RESEND_WEBHOOK_SECRET=""

# false: reject "+tag" email aliases (alice+alias@gmail.com) at registration.
# true (default): accept them, but treat +tag/dot variants as the same account.
ALLOW_EMAIL_ALIASES=true