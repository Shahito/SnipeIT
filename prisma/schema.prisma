datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                       Int           @id @default(autoincrement())
  username                 String        @unique
  displayUsername         String
  password                String
  email                    String?       @unique
  emailVerified            Boolean       @default(false)
  emailVerificationToken   String?       @unique
  emailVerificationExpires DateTime?
  tokenVersion             Int           @default(0)
  createdAt                DateTime      @default(now())
  lastActive               DateTime      @default(now())

  strategies      Strategy[]
  apiKeys         ApiKey[]
  tags            Tag[]
  sweepGroups     SweepGroup[]
}

model ApiKey {
  id            Int       @id @default(autoincrement())
  userId        Int
  name          String
  keyHash       String    @unique
  keyPrefix     String
  lastUsedAt    DateTime?
  lastHeartbeat DateTime?   // updated by the worker every N seconds
  createdAt     DateTime  @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs          BacktestJob[]
}

model Strategy {
  id             Int           @id @default(autoincrement())
  userId         Int
  name           String
  description    String?       @db.Text
  pairs          Json          // string[] - e.g. ["BTC/USDT"] (single run) or ["BTC/USDT","ETH/USDT",...] (sweep)
  // Sweepable fields: scalar OR { sweep: [v1, v2, ...] }. Resolved to a pure
  // scalar in BacktestJob.strategySnapshot at launch time (see sweepEngine).
  timeframe      Json          // String or { sweep: [...] }
  startDate      DateTime
  endDate        DateTime
  initialCapital Float         @default(1000)
  positionSize   Json          // Float or { sweep: [...] }
  stopLoss       Json?         // Float or { sweep: [...] }
  takeProfit     Json?         // Float or { sweep: [...] }
  trailingStopLoss Json?       // Float or { sweep: [...] }
  slType         Json?         // "percent"|"atr" or { sweep: [...] }
  tpType         Json?         // "percent"|"atr" or { sweep: [...] }
  atrPeriod      Json?         // Int or { sweep: [...] }
  feeTaker       Float         @default(0.0)
  feeMaker       Float         @default(0.0)
  tradingHours   Json?                          // [{start:"08:00", end:"17:00", blockSell:false}]
  conditions     Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  clonedFrom     Int?

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs           BacktestJob[]
  sweepGroups    SweepGroup[]
}

model BacktestJob {
  id             Int       @id @default(autoincrement())
  strategyId     Int
  apiKeyId       Int?
  sweepGroupId   Int?
  pair           String?   // resolved pair for this specific run (real column, for sort/filter)
  paramValues    Json?     // resolved sweep-axis values for this run (excluding pair)
  resultHash     String?   @db.VarChar(64) // sha256(strategySnapshot)
  reusedFromJobId Int?
  status         String    @default("pending")
  claimedAt      DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?   @db.Text
  result         Json?
  strategySnapshot Json?

  pnlPercent     Float?
  pnlAbsolute    Float?
  finalCapital   Float?
  initialCapital Float?
  totalTrades    Int?
  winRate        Float?
  maxDrawdown    Float?
  sharpeRatio    Float?
  durationDays   Int?
  profitFactor   Float?

  createdAt      DateTime  @default(now())
  strategy       Strategy   @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  apiKey         ApiKey?    @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  sweepGroup     SweepGroup? @relation(fields: [sweepGroupId], references: [id], onDelete: Cascade)
  jobTags        JobTag[]

  @@index([sweepGroupId])
  @@index([pair])
  @@index([strategyId, resultHash])
}

model SweepGroup {
  id                 Int       @id @default(autoincrement())
  strategyId         Int
  userId             Int
  name               String?
  definitionSnapshot Json      // full strategy definition at launch time (including sweep axes)
  totalRuns          Int
  status             String    @default("pending") // pending | running | done | partial_error | error
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  strategy Strategy      @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs     BacktestJob[]
}

model Tag {
  id        Int       @id @default(autoincrement())
  userId    Int
  name      String
  color     String    @default("#6c8eff")  // couleur HEX
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTags   JobTag[]
}

model JobTag {
  jobId Int
  tagId Int

  job   BacktestJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag   Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
}
